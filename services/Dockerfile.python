# Shared build stage for all Python services (uv workspace aware).
# Build from the repository root:
#   docker build -f services/api/Dockerfile .
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services ./services

# Install only the requested package plus its workspace dependencies.
ARG PACKAGE_NAME
RUN uv sync --frozen --no-dev --package "${PACKAGE_NAME}"

FROM python:3.12-slim-bookworm AS runtime

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd -r via && useradd -r -g via via
WORKDIR /app
COPY --from=builder --chown=via:via /app /app
USER via

ARG MODULE_PATH
ARG PORT
ENV MODULE_PATH=${MODULE_PATH} \
    PORT=${PORT}
EXPOSE ${PORT}

CMD ["sh", "-c", "python -m uvicorn ${MODULE_PATH}:app --host 0.0.0.0 --port ${PORT:-8080}"]
