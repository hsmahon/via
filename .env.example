# =============================================================================
# Via - Video Intelligence Agent
# Copy to `.env` and adjust. All variables use the `VIA_` prefix.
# =============================================================================

# --- Global ---
VIA_ENV=local
VIA_LOG_LEVEL=INFO
VIA_AWS_REGION=us-east-1

# Localstack-style test credentials (DynamoDB Local / MinIO ignore them,
# but boto3 requires them to be present.)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Storage ---
VIA_TABLE_NAME=via
VIA_BUCKET=via-videos

# Endpoints used by server-side SDK calls inside containers.
# Leave empty when running against real AWS.
VIA_DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
VIA_S3_ENDPOINT_URL=http://minio:9000

# Endpoint embedded into presigned URLs. Must be reachable from the CLIENT
# (browser/curl on the host), not from the API container.
VIA_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- API service ---
VIA_API_PORT=8080
VIA_PRESIGN_EXPIRY_SECONDS=900
VIA_DEFAULT_USER_ID=dev-user

# --- Agent service ---
VIA_AGENT_PORT=8081

# --- Worker ---
VIA_WORKER_PORT=8082
# When true, the worker invokes the (not yet implemented) Transcribe /
# TwelveLabs Pegasus hook interfaces; they raise NotImplementedError which
# marks the video FAILED. Keep false until integrations land.
VIA_PROCESSING_HOOKS_ENABLED=false

# --- UI ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- MinIO (local S3) ---
# Must look like AWS credentials (used for presigned signatures).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Host port for MinIO S3 API (remap if 9000 is taken on your machine).
VIA_MINIO_PORT=9000
