# =============================================================================
# Via - Video Intelligence Agent
# Copy to `.env` and adjust. All variables use the `VIA_` prefix.
# =============================================================================

# --- Global ---
VIA_ENV=local
VIA_LOG_LEVEL=INFO
VIA_AWS_REGION=us-east-1

# For real S3, export AWS credentials via env/SSO/IAM; these test values only
# satisfy boto3 against DynamoDB Local.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Storage ---
VIA_TABLE_NAME=via
VIA_BUCKET=via-videos

# Endpoints used by server-side SDK calls inside containers.
# Leave empty when running against real AWS.
VIA_DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000

# S3 — leave endpoints empty for real AWS. Only set for LocalStack or custom endpoint.
# VIA_S3_ENDPOINT_URL=
# VIA_S3_PUBLIC_ENDPOINT_URL=

# --- API service ---
VIA_API_PORT=8080
VIA_PRESIGN_EXPIRY_SECONDS=900
VIA_DEFAULT_USER_ID=dev-user

# --- Agent service ---
VIA_AGENT_PORT=8081

# --- Worker ---
VIA_WORKER_PORT=8082
# When true, the worker invokes the (not yet implemented) Transcribe /
# TwelveLabs Pegasus hook interfaces; they raise NotImplementedError which
# marks the video FAILED. Keep false until integrations land.
VIA_PROCESSING_HOOKS_ENABLED=false

# --- UI ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- S3 ---
# VIA_BUCKET is the only required storage var. Leave VIA_S3_* endpoints empty
# for real AWS; set them to http://localhost:4566 for LocalStack.
