{
  "name": "via-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Via - Video Intelligence Agent (JS workspace root)",
  "workspaces": [
    "frontend/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p frontend/ui --noEmit",
    "test": "vitest run --root frontend/ui",
    "docstrings:test": "vitest run --root frontend/ui docstrings"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11"
  }
}
