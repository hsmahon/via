{
  "name": "via-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Via - Video Intelligence Agent (JS workspace root)",
  "workspaces": [
    "frontend/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p frontend/ui --noEmit",
    "test": "vitest run --root frontend/ui",
    "docstrings:test": "vitest run --root frontend/ui docstrings"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.9",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
